# Autonomy Explorer — Environment Variables
# Copy to .env and fill in your keys

# TravelTime API (for public transport routing)
# Sign up at https://account.traveltime.com/
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Geoapify API (for driving times with traffic data)
# Sign up free (no credit card) at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Frontend: Geoapify key for custom location routing (Vite injects VITE_ prefixed vars)
VITE_GEOAPIFY_API_KEY=
